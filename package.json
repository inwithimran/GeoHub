{
  "name": "geohub",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "GeoHub — Connect with Department",
  "scripts": {
    "test": "node --test test/validators.test.js",
    "test:rules": "firebase emulators:exec --only firestore \"node --test test/firestore-rules.test.js\"",
    "test:all": "npm run test && npm run test:rules",
    "build:www": "node scripts/build-www.mjs",
    "android:add": "npx cap add android",
    "android:sync": "npm run build:www && npx cap sync android"
  },
  "dependencies": {
    "firebase-admin": "^12.3.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "firebase": "^10.13.0",
    "firebase-tools": "^13.15.0",
    "@capacitor/core": "^6.1.2",
    "@capacitor/cli": "^6.1.2",
    "@capacitor/android": "^6.1.2",
    "@capacitor/app": "^6.0.1",
    "@capacitor-firebase/messaging": "^6.3.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor-firebase/authentication": "^6.3.0"
  }
}
