rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    // NOTE: Firestore Security Rules cannot import JS, so this allowlist
    // cannot be centralized like the server/client copies are (see
    // /shared/admin-config.js). If you add/change an admin, update BOTH
    // this list and /shared/admin-config.js, and keep them identical.
    function isAdmin() {
      return isSignedIn() && request.auth.token.email in [
        "in.with.imran@gmail.com"
      ];
    }
    function onlyChangedFields(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }
    function pollVoteOnly() {
      return onlyChangedFields(["poll"]) &&
        ("poll" in resource.data) &&
        request.resource.data.poll.options == resource.data.poll.options &&
        request.resource.data.poll.votes.diff(resource.data.poll.votes).affectedKeys().hasOnly([request.auth.uid]);
    }
    function textWithinLimit(field, maxLen) {
      return !(field in request.resource.data) ||
        (request.resource.data[field] is string && request.resource.data[field].size() <= maxLen);
    }

    match /users/{uid} {
      allow read: if isSignedIn();
      // Profile creation is validated server-side (Admin SDK, which bypasses
      // these rules) via /api/create-profile and /api/resolve-profile.
      // Direct client-side creates are never allowed.
      allow create: if false;
      allow update: if isOwner(uid) && onlyChangedFields(["lastActive"]);
      allow delete: if false;

      match /private/{docId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if isOwner(uid);
        allow update: if false;
      }

      match /fcmTokens/{token} {
        allow read, write: if isOwner(uid);
      }

      match /readState/{kind} {
        allow read, write: if isOwner(uid);
      }

      match /bookmarks/{resId} {
        allow read, write: if isOwner(uid);
      }
    }

    match /activity/{activityId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        !(resource.data.type in ["comment", "reply", "like", "comment-like", "mention"]) ||
        resource.data.targetUid == request.auth.uid ||
        resource.data.actorUid == request.auth.uid
      );
      allow create: if isSignedIn() && request.resource.data.actorUid == request.auth.uid;
      allow update: if false; 
      allow delete: if isSignedIn() && (
        isAdmin() ||
        resource.data.actorUid == request.auth.uid ||
        resource.data.targetUid == request.auth.uid
      );
    }

    match /posts/{postId} {
      allow read: if isSignedIn();
      // Creates and text/image/mention edits are validated server-side
      // (Admin SDK, which bypasses these rules) via /api/create-post and
      // /api/edit-post. Only the narrow, self-contained updates below are
      // ever allowed as direct client writes.
      allow create: if false;
      allow update: if (isSignedIn() && onlyChangedFields(["likes", "reactions"])) ||
        (isSignedIn() && pollVoteOnly()) ||
        (isAdmin() && onlyChangedFields(["pinned", "pinnedAt"]));
      allow delete: if isOwner(resource.data.authorUid) || isAdmin();

      match /comments/{commentId} {
        allow read: if isSignedIn();
        // Same story as posts/{postId} above — see /api/create-comment and
        // /api/edit-comment.
        allow create: if false;
        allow update: if isSignedIn() && onlyChangedFields(["reactions"]);
        allow delete: if isOwner(resource.data.authorUid) || isAdmin() ||
          isOwner(get(/databases/$(database)/documents/posts/$(postId)).data.authorUid);
      }
    }

    match /classChat/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.authorUid == request.auth.uid && textWithinLimit("text", 1000);
      allow update: if isOwner(resource.data.authorUid) && textWithinLimit("text", 1000);
      allow delete: if isOwner(resource.data.authorUid) || isAdmin();
    }

    match /classChatReads/{uid} {
      allow read, write: if isOwner(uid);
    }

    match /conversations/{conversationId} {
      function blockedByChangeValid() {
        let before = ("blockedBy" in resource.data) ? resource.data.blockedBy : [];
        let after = ("blockedBy" in request.resource.data) ? request.resource.data.blockedBy : [];
        return after.removeAll([request.auth.uid]).hasOnly(before.removeAll([request.auth.uid])) &&
          before.removeAll([request.auth.uid]).hasOnly(after.removeAll([request.auth.uid])) &&
          after.hasOnly(resource.data.participants);
      }
      allow read: if isSignedIn() &&
        (resource == null || request.auth.uid in resource.data.participants);
      allow create: if isSignedIn() &&
        request.auth.uid in request.resource.data.participants &&
        request.resource.data.participants.size() == 2;
      allow update: if isSignedIn() &&
        request.auth.uid in resource.data.participants &&
        request.resource.data.participants == resource.data.participants &&
        onlyChangedFields(["unread", "lastMessageText", "lastMessageAt", "lastSenderUid", "blockedBy", "lastReadAt", "typing"]) &&
        blockedByChangeValid();
      allow delete: if false;

      match /messages/{messageId} {
        function isDmParticipant() {
          return isSignedIn() &&
            request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        }
        function isDmBlocked() {
          let convo = get(/databases/$(database)/documents/conversations/$(conversationId)).data;
          return ("blockedBy" in convo) && convo.blockedBy.size() > 0;
        }
        allow read: if isDmParticipant();
        allow create: if isDmParticipant() && !isDmBlocked() && request.resource.data.senderUid == request.auth.uid && textWithinLimit("text", 2000);
        allow update: if false; 
        allow delete: if isOwner(resource.data.senderUid);
      }
    }

    match /resources/{resId} {
      function openCountIncrementValid() {
        return onlyChangedFields(["openCount"]) &&
          request.resource.data.openCount is int &&
          resource.data.openCount is int &&
          request.resource.data.openCount == resource.data.openCount + 1;
      }
      allow read: if isSignedIn();
      // Creates and edits (title/category/link) are validated server-side
      // (Admin SDK, which bypasses these rules) via /api/create-resource
      // and /api/edit-resource. Any signed-in reader may still bump the
      // view/download counter by exactly 1 per write.
      allow create: if false;
      allow update: if isSignedIn() && openCountIncrementValid();
      allow delete: if isOwner(resource.data.contributorUid) || isAdmin();
    }

    match /notices/{noticeId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && textWithinLimit("text", 1000);
      allow update: if isAdmin() && textWithinLimit("text", 1000);
      allow delete: if isAdmin();
    }

    match /routine/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /deadlines/{deadlineId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && textWithinLimit("title", 200) && textWithinLimit("notes", 1000);
      allow update: if isAdmin() && textWithinLimit("title", 200) && textWithinLimit("notes", 1000);
      allow delete: if isAdmin();
    }

    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && request.resource.data.reportedByUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /pushRateLimits/{uid} {
      allow read, write: if false;
    }
  }
}
